.venv/
__pycache__/
*.egg-info/
.DS_Store
*.mp4

# rendered output
/results/*
!/results/.gitkeep

# API keys for authoring-time tools (Kiri TTS). Never committed.
.env

# Narration: audio from a paid API, kept only so it need not be bought again.
# Not ours to publish. Each example's `speak.py` (or `narrate.py`) rebuilds it from
# the captions and a key.
*/*/audio/

# Examples kept local. `fourier_einstein` traces a copyrighted engraving it reads at
# build time, so the input is not ours to redistribute even though the code is;
# `pypi_nightly` is a one-off announcement clip.
/mathematics/fourier_einstein/
/about-codimate/pypi_nightly/
/attention/
/eyetwist/
